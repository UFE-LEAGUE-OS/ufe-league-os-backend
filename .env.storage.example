
# Local SeaweedFS credentials.
# Generate different credentials before any production deployment.

S3_ACCESS_KEY_ID=league-os-local-admin
S3_SECRET_ACCESS_KEY=league-os-local-secret-change-before-production

S3_PUBLIC_BUCKET_NAME=league-os-public
S3_PRIVATE_BUCKET_NAME=league-os-private

# Internal endpoint used by Django containers.
S3_ENDPOINT_URL=http://object-storage:8333
S3_REGION_NAME=us-east-1
S3_ADDRESSING_STYLE=path

# Browser-facing local URL used for public media URLs.
S3_PUBLIC_CUSTOM_DOMAIN=127.0.0.1:8333/league-os-public
S3_PUBLIC_URL_PROTOCOL=http:

# Signed private URLs remain valid for 15 minutes.
S3_PRIVATE_URL_EXPIRY=900

# SeaweedFS S3 port exposed only on the local host.
S3_HOST_PORT=8333

# SeaweedFS requires a bucket policy for anonymous public reads.
# Leave this disabled for providers where policies are managed externally.
S3_MANAGE_BUCKET_POLICIES=True
S3_BOOTSTRAP_MAX_ATTEMPTS=30
S3_BOOTSTRAP_RETRY_SECONDS=2
