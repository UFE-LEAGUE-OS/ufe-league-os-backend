# Local SeaweedFS credentials.
# Production credentials must be generated separately and must never be committed.

S3_ACCESS_KEY_ID=league-os-local-admin
S3_SECRET_ACCESS_KEY=league-os-local-secret-change-before-production

# SeaweedFS accepts a comma-separated list of buckets.
S3_BUCKETS=league-os-public,league-os-private

# Bound to localhost by docker-compose.storage.yml.
S3_HOST_PORT=8333
