# =========================================================
# League OS Backend Environment Example
# Copy this file to .env for local development.
# Never commit real production secrets.
# =========================================================

DJANGO_SECRET_KEY=league-os-development-secret-key-change-before-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DB_NAME=league_os
DB_USER=league_os_user
DB_PASSWORD=league_os_password
DB_HOST=db
DB_PORT=5432

POSTGRES_DB=league_os
POSTGRES_USER=league_os_user
POSTGRES_PASSWORD=league_os_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Leave blank for local Docker development.
# Use this only on Render/Neon staging or production.
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# =========================================================
# Local OTP testing
# =========================================================
# For localhost:
# SEND_OTP_EMAILS=False means no real email is sent.
# PRINT_DEV_OTPS=True prints OTPs in backend Docker logs.

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SEND_OTP_EMAILS=False
PRINT_DEV_OTPS=True

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20

DEFAULT_FROM_EMAIL=League OS <noreply@leagueos.local>
SERVER_EMAIL=League OS <noreply@leagueos.local>

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# =========================================================
# Google OAuth2 Settings
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# =========================================================

GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret

# =========================================================
# Brevo SMTP settings for Render/staging
# =========================================================
# Use these on Render, not in normal local testing:
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SEND_OTP_EMAILS=True
# PRINT_DEV_OTPS=False
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=2525
# EMAIL_HOST_USER=your-brevo-smtp-login
# EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=League OS <verified-sender@example.com>
# SERVER_EMAIL=League OS <verified-sender@example.com>

# =========================================================
# Flutterwave Test Payment Settings
# =========================================================

FLUTTERWAVE_MODE=test
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-test-public-key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-test-secret-key
FLUTTERWAVE_SECRET_HASH=replace-with-random-test-webhook-secret

FLUTTERWAVE_REDIRECT_URL=http://localhost:8000/api/sponsorships/flutterwave/verify/
FLUTTERWAVE_TICKET_REDIRECT_URL=http://localhost:8000/api/ticketing/flutterwave/verify/

FLUTTERWAVE_PAYMENT_TITLE=League OS Sponsorship Payment
FLUTTERWAVE_TICKET_PAYMENT_TITLE=League OS Match Ticket Payment

FLUTTERWAVE_PAYMENT_LOGO_URL=
FLUTTERWAVE_TIMEOUT_SECONDS=30
TICKET_RESERVATION_MINUTES=10

# -------------------------------------------------------------------
# Media storage
# -------------------------------------------------------------------
# Local development:
# USE_S3_MEDIA=False

# Staging / production with DigitalOcean Spaces:
# USE_S3_MEDIA=True
# AWS_STORAGE_BUCKET_NAME=league-os-demo-media-staging
# AWS_S3_REGION_NAME=fra1
# AWS_S3_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
# AWS_S3_CUSTOM_DOMAIN=league-os-demo-media-staging.fra1.digitaloceanspaces.com
# AWS_ACCESS_KEY_ID=replace-with-digitalocean-spaces-key
# AWS_SECRET_ACCESS_KEY=replace-with-digitalocean-spaces-secret
# AWS_QUERYSTRING_AUTH=False
# AWS_DEFAULT_ACL=public-read
