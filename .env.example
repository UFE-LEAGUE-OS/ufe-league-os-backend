# =========================================================
# League OS Backend Local Development Environment
# Copy this file to .env for local development:
#
# cp .env.example .env
# =========================================================


# =========================================================
# Django Core Settings
# =========================================================

DJANGO_SECRET_KEY=league-os-development-secret-key-change-before-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0


# =========================================================
# Django Database Connection Settings
# These are used by Django to connect to PostgreSQL.
# =========================================================

DB_NAME=league_os
DB_USER=league_os_user
DB_PASSWORD=league_os_password
DB_HOST=db
DB_PORT=5432


# =========================================================
# PostgreSQL Container Initialization Settings
# These are used by the PostgreSQL Docker container.
# They must match the DB_* values above.
# =========================================================

POSTGRES_DB=league_os
POSTGRES_USER=league_os_user
POSTGRES_PASSWORD=league_os_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# =========================================================
# Hosted PostgreSQL Connection
# Used by Render/Neon staging.
# Leave blank for local Docker development.
# =========================================================

DATABASE_URL=

# =========================================================
# Frontend / CORS / CSRF Settings
# This allows the React frontend to call the backend locally.
# =========================================================

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# =========================================================
# Email / OTP Settings
# In local development, OTP emails will be printed in backend logs.
# =========================================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@leagueos.local
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# =========================================================
# Flutterwave Test Payment Settings
# Use TEST keys in development. Never commit live secret keys.
# =========================================================

FLUTTERWAVE_MODE=test
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-test-public-key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-test-secret-key
FLUTTERWAVE_SECRET_HASH=replace-with-random-test-webhook-secret
FLUTTERWAVE_REDIRECT_URL=http://localhost:8000/api/sponsorships/flutterwave/verify/
FLUTTERWAVE_PAYMENT_TITLE=League OS Sponsorship Payment
FLUTTERWAVE_PAYMENT_LOGO_URL=
FLUTTERWAVE_TIMEOUT_SECONDS=30